{
  "name": "HealthCare Portal — Clinical & Patient Care",
  "short_name": "HealthCare",
  "description": "Modern healthcare appointment booking, clinic finder, specialist directory, and clinical records management.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#f1f5f9",
  "theme_color": "#2563eb",
  "categories": ["medical", "health", "productivity"],
  "icons": [
    {
      "src": "assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "assets/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Book Appointment",
      "short_name": "Book",
      "description": "Schedule a new clinical consultation",
      "url": "./index.html?action=book",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Find Clinics",
      "short_name": "Clinics",
      "description": "Explore nearby healthcare centers on the map",
      "url": "./index.html?view=explore",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "My Appointments",
      "short_name": "Appointments",
      "description": "View scheduled and past visits",
      "url": "./index.html?view=appointments",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
